# Supabase injects its SUPABASE_URL, SUPABASE_ANON_KEY, and
# SUPABASE_SERVICE_ROLE_KEY variables into Edge Functions. Do not set those as
# custom secrets; the service-role key must never be used in either client.
# Enter the project URL and public anon key in the app settings.
SUPABASE_URL=https://example-project.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.example_anon_key
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.example_service_role_key
APP_ORIGIN=https://your-web-app.example

# Keep all LLM credentials in the Supabase Edge Function secret store.
# Do not add provider keys to Android build config, the web app, or Git.
LLM_ENGINE_1_ENABLED=true
LLM_ENGINE_1_API_KEY=sk-proj-example-openai-key-1234567890
LLM_ENGINE_1_BASE_URL=https://api.openai.com/v1
LLM_ENGINE_1_MODEL_ID=gpt-4o-mini
LLM_ENGINE_1_TIMEOUT_MS=20000
LLM_ENGINE_1_MAX_RETRIES=1
LLM_ENGINE_1_RETRY_DELAY_MS=250

LLM_ENGINE_2_ENABLED=true
LLM_ENGINE_2_API_KEY=sk-ant-example-anthropic-key-abcdef123456
LLM_ENGINE_2_BASE_URL=https://api.anthropic.com
LLM_ENGINE_2_MODEL_ID=claude-3-5-sonnet-20241022
LLM_ENGINE_2_TIMEOUT_MS=20000
LLM_ENGINE_2_MAX_RETRIES=1
LLM_ENGINE_2_RETRY_DELAY_MS=250

LLM_ENGINE_3_ENABLED=true
LLM_ENGINE_3_API_KEY=AIzaSyExampleGeminiKey1234567890
LLM_ENGINE_3_BASE_URL=https://generativelanguage.googleapis.com
LLM_ENGINE_3_MODEL_ID=gemini-1.5-pro
LLM_ENGINE_3_TIMEOUT_MS=20000
LLM_ENGINE_3_MAX_RETRIES=1
LLM_ENGINE_3_RETRY_DELAY_MS=250

LLM_ENGINE_4_ENABLED=true
LLM_ENGINE_4_API_KEY=gsk_example_groq_key_123456789
LLM_ENGINE_4_BASE_URL=https://api.groq.com/openai/v1
LLM_ENGINE_4_MODEL_ID=llama-3.1-70b-versatile
LLM_ENGINE_4_TIMEOUT_MS=20000
LLM_ENGINE_4_MAX_RETRIES=1
LLM_ENGINE_4_RETRY_DELAY_MS=250

LLM_ENGINE_5_ENABLED=true
LLM_ENGINE_5_API_KEY=sk-or-v1-example-openrouter-key-123456789
LLM_ENGINE_5_BASE_URL=https://openrouter.ai/api/v1
LLM_ENGINE_5_MODEL_ID=openai/gpt-4o-mini
LLM_ENGINE_5_TIMEOUT_MS=20000
LLM_ENGINE_5_MAX_RETRIES=1
LLM_ENGINE_5_RETRY_DELAY_MS=250
